datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]

  @@index([email])
  @@map("users")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  company   String
  source    String   @default("WEBSITE")
  status    String   @default("NEW")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([name])
  @@map("leads")
}
